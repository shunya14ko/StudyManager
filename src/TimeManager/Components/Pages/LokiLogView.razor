@page "/LogView"
@using System.Text.Json
@using System.Threading
@using TaskManager.LokiData
@using TaskManager.Services
@inject HttpClient _httpClient
@inject PollingManager _pollingManager
@implements IDisposable

<div>
    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
        <h3>Log Monitor</h3>
        <FluentSpacer />
        <FluentDivider Orientation="Orientation.Vertical" Role="DividerRole.Presentation" />
        <FluentButton Appearance="Appearance.Accent" OnClick=@Connect Disabled=@_isPolling>▶ START</FluentButton>
        <FluentButton Appearance="Appearance.Outline" OnClick=@DisConnect Disabled=@(!_isPolling)>■ STOP</FluentButton>
    </FluentStack>

    <div style="overflow-y: scroll; overflow-x: auto; min-height: calc(100vh - 100px); background-color: aliceblue;">
        <FluentDataGrid Items=@Logs.AsQueryable()
                        GenerateHeader="@GenerateHeaderOption.Sticky"
                        DisplayMode=DataGridDisplayMode.Table
                        Virtualize=@true
                        ResizeType=@DataGridResizeType.Discrete
                        ResizableColumns=true
                        ShowHover=@true
                        Style="min-width: 100%">
            <PropertyColumn Property=@(p => p.Timestamp) Title="Time" Format="HH:mm:ss.fff" Width="150px" />
            <PropertyColumn Property=@(p => p.Endpoint) Title="Endpoint" Width="150px" />
            <PropertyColumn Property=@(p => p.DurationMs) Title="Latency(ms)" Width="200px" />
            <PropertyColumn Property=@(p => p.Message) Title="Message" Style="min-width: 300px;">
                <ColumnOptions>
                    <FluentSearch @bind-Value=@_text
                                  Placeholder="Search..."
                                  Autofocus="true" />
                </ColumnOptions>
            </PropertyColumn>

        </FluentDataGrid>
    </div>
</div>

@code {
    private bool _isPolling = false;
    private CancellationTokenSource? _cts;
    private string _text = string.Empty;
    private string _searchText = string.Empty;

    private List<LogsModel> Logs { get; } = [];

    // polling process is services, so that it can be shared by multiple components if needed.
    private async Task Connect()
    {
        if (_isPolling)
        {
            return;
        }

        _isPolling = true;

        // initial processing
        _cts = new CancellationTokenSource();

        // Initial Move
        var progress = new Progress<LogsModel>(log =>
        {
            Logs.Add(log);
            StateHasChanged();
        });

        // Start Polling
        try
        {
            await _pollingManager.StartPolling(progress, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Handle cancellation if needed
        }
        finally
        {
            _isPolling = false;
            StateHasChanged();
        }
    }

    private void DisConnect()
    {
        _cts?.Cancel();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}