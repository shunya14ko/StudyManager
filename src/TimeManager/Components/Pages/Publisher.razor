@page "/publisher"
@using Microsoft.Extensions.Hosting
@inject IConfiguration Configuration
@rendermode InteractiveServer

<h3>Publisher</h3>
@* Fluent UIを触ってみる UIのコンポーネントで値を入力してPutするまでの実現をする *@

<button class="btn btn-primary" @onclick="Publish">Primary Button</button>

<list>
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>TimeInfo</th>
            </tr>
        </thead>
    </table>
</list>
<div>@putResult</div>

@code {
    // スネークケースは、基本的にreadonlyプロパティにする
    private List<ViewModels?> viewModels { get; set; } = new List<ViewModels?>();
    private string putResult { get; set; } = string.Empty;

    private async Task Publish()
    {
        var settingUri = Configuration.GetValue<ViewModels>("Api:Handler");
        using var client = new HttpClient();
        try
        {
            var eventModel = new ViewModels
            {
                id = Guid.NewGuid().ToString(),
                Name = "TestName",
                timeInfo = DateTime.Now,
            };

            client.Timeout = TimeSpan.FromSeconds(5);
            var url = $"{settingUri}/reserve";
            var response = await client.PutAsJsonAsync(url, eventModel);

            if (response.StatusCode == System.Net.HttpStatusCode.OK)
            {
                putResult = "Put成功";
            }
            else
            {
                putResult = "Put失敗";
            }
        }
        // 本当はExceptionでうけないでもっと下の例外クラスで受ける必要がある。
        catch (Exception ex)
        {
            putResult = "Put失敗";
            Console.WriteLine(ex.Message);
            //toast.service.ShowError("取得に失敗しました");
        }
    }

    public class ViewModels
    {
        // 汎用的にする場合のみ
        public string id { get; set; } = Guid.NewGuid().ToString();
        public string Name { get; set; } = string.Empty;
        public DateTime timeInfo { get; set; } = DateTime.MinValue;
    }
}
