@page "/MainProject"
@using Microsoft.Extensions.Hosting
@using Communication.Services
@using Communication.Services.Models
@using System.ComponentModel.DataAnnotations
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons
@using TaskManager.Validations.Attributes
@using TaskManager.Validations.Services
@inject EditContextPipeline _pipeline
@inject IToastService _toastService
@inject IDialogService _dialogService
@inject HttpClientRest _httpClientRest

<h3>MainProject</h3>
@* Fluent UIを触ってみる UIのコンポーネントで値を入力してPutするまでの実現をする *@

<FluentCard Width="Flex">
    <FluentEditForm EditContext=@editContext OnValidSubmit=@PutTestData>
        <DataAnnotationsValidator />
        <EditContextPipeline />

        <FluentStack Orientation="Orientation.Vertical">
            <div>
                <FluentTextField @bind-Value="formModel.ProjectId" Immediate="true" @oninput="@(() => StateHasChanged())" Label="ID" Required="true" />
                <FluentValidationMessage For="@(() => formModel.ProjectId)" />
            </div>

            <div>
                <FluentTextField @bind-Value="formModel.ProjectName" Label="Name" />
            </div>
            <div>
                <FluentNumberField @bind-Value="formModel.ProjectTestInfo" Label="WarningTestNum" Min="1" Max="50" />
                <FluentValidationMessage For="@(() => formModel.ProjectTestInfo)" />
            </div>
            <FluentButton Type="ButtonType.Submit" Appearance="@Appearance.Accent" Disabled=@UserFieldErrorFlag>送信</FluentButton>
        </FluentStack>
    </FluentEditForm>
</FluentCard>

<table class="table">
    <tbody>
        @foreach (var item in viewModels)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.TestInfo</td>
            </tr>
        }
    </tbody>
</table>
<div>@putResult</div>

@code {
    // スネークケースは、基本的にreadonlyプロパティにする
    private ProjectFormModel formModel = new();
    private List<MainProjectDto> viewModels = [];
    private EditContext editContext = default!;
    private string putResult = string.Empty;
    public bool UserFieldErrorFlag = false;

    // 属性に渡す値は 'const' である必要があります
    private const int ThresholdValue = 10;
    private const string ErrorMessage = "値は10以上である必要があります";

    // バリデーション用のクラス
    public class ProjectFormModel
    {
        [Required(ErrorMessage = "IDは必須入力です")]
        public string ProjectId { get; set; } = string.Empty;

        public string ProjectName { get; set; } = string.Empty;

        // Attribute部分はクラス名のみでOKらしい・・・
        [Threshold(ThresholdValue, ErrorMessage)]
        public int ProjectTestInfo { get; set; } = 10;
    }

    protected override async Task OnInitializedAsync()
    {
        // 初期化処理があればここに記述
        editContext = new EditContext(formModel);

        // フィールドの値が変更されたら実行されるイベント
        editContext.OnFieldChanged += (sender, eventArgs) =>
        {
            // Validate() を呼ぶと画面にエラーメッセージが表示され、結果が返る
            UserFieldErrorFlag = editContext.Validate();

            // 状態が変わったことを Blazor に通知して再描画
            StateHasChanged();
        };
    }

    private async Task PutTestData()
    {
        try
        {
            var eventModel = new MainProjectDto
            {
                Id = formModel.ProjectId,
                Name = formModel.ProjectName,
                TestInfo = formModel.ProjectTestInfo,
            };

            var hasWarning = _pipeline.HasWarnings(formModel);

            if (hasWarning)
            {
                var confirm = await OpenDialog();
                if (!confirm.Cancelled)
                {
                    viewModels.Add(eventModel);
                    await _httpClientRest.UpdateMainProjectAsync(eventModel);
                    _toastService.ShowToast(ToastIntent.Success, "保存しました");
                }
            }
            else
            {
                viewModels.Add(eventModel);
                await _httpClientRest.UpdateMainProjectAsync(eventModel);
                _toastService.ShowToast(ToastIntent.Success, "保存しました");
            }
        }
        catch (Exception ex)
        {
            putResult = "Put失敗";
            _toastService.ShowToast(ToastIntent.Error, $"エラー: {ex.Message}");
        }
    }

    private async Task<DialogResult> OpenDialog()
    {
        // ダイアログの内容を定義（テキストボックスを削除し、警告アイコンを追加）
        var dialogInstance = await _dialogService.ShowDialogAsync(@<div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <FluentIcon Value="@(new Icons.Regular.Size48.Warning())" Color="@Color.Warning" />
                <span>実行してもよろしいですか？<br>この操作は取り消せません。</span>
            </div>
        </div>, new DialogParameters
        {
            Title = "警告",
        PrimaryAction = "はい",
        SecondaryAction = "いいえ",
    });

        var result = await dialogInstance.Result;
        return result;
    }
}
